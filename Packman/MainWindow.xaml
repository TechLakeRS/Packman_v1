<Window x:Class="Packman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Packman.Views"
        xmlns:vm="clr-namespace:Packman.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="PACKMAN — Create Package"
        Width="1320" Height="860"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LogoGradientBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#3B67F5" Opacity="0.42" ShadowDepth="4" BlurRadius="12" Direction="270"/>
                        </Border.Effect>
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconBox}" Stroke="White" StrokeThickness="1.9" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="PACKMAN" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource FreePill}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="FREE" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>

                <Border Grid.Column="2" Width="300" Height="38" CornerRadius="10"
                        Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Search applications, packages…" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource Muted2Brush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,11,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Docs" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Command="{Binding ThemeToggleCommand}" ToolTip="Toggle theme" Margin="0,0,11,0">
                        <Viewbox Width="17" Height="17">
                            <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconMoon}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconSun}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Margin="0,0,11,0">
                        <Grid>
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
                        </Grid>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AvatarGradientBrush}">
                            <TextBlock Text="AD" FontWeight="ExtraBold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="admin.sarker" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Text="Contoso IT" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True" Margin="14,16">
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Packages this month" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Free plan includes 25 / month" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource LineBrush}">
                                <Border Width="100" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="15 of 25 used" FontSize="10.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.3" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Create Package" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource IconUpload}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Upload to Intune" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource IconGrid}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Applications" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconMonitor}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Remote Test" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Sign" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconWrench}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Advanced" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconGear}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel Margin="30,24,30,26">
                    <StackPanel>
                        <TextBlock Text="Create Package" Style="{StaticResource H1}"/>
                        <TextBlock Text="Build a new application package for Intune deployment" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Stepper -->
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="8,24,8,22">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                <Button Cursor="Hand"
                                        Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding Index}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Column="0" Grid.Row="0" Height="2" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Column="2" Grid.Row="0" Height="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Column="1" Grid.Row="0" Width="34" Height="34" CornerRadius="17" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#3B67F5" Opacity="0.22" ShadowDepth="0" BlurRadius="14"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Viewbox Width="15" Height="15" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Center" Margin="0,9,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Step stage: visibility tied to each step's IsCurrent -->
                    <Grid>
                        <views:StepGenerate Visibility="{Binding Steps[0].IsCurrent, Converter={StaticResource BoolToVis}}"/>
                        <views:StepEdit     Visibility="{Binding Steps[1].IsCurrent, Converter={StaticResource BoolToVis}}"/>
                        <views:StepTest     Visibility="{Binding Steps[2].IsCurrent, Converter={StaticResource BoolToVis}}"/>
                        <views:StepUpload   Visibility="{Binding Steps[3].IsCurrent, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Footer -->
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,18,0,0">
                        <Grid>
                            <Button Style="{StaticResource BackButton}" HorizontalAlignment="Left" Command="{Binding BackCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{StaticResource IconChevL}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Back" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SkipButton}" Content="Skip" Margin="0,0,10,0"
                                        Command="{Binding SkipCommand}"
                                        Visibility="{Binding SkipVisible, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrimaryCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PrimaryLabel}" VerticalAlignment="Center"/>
                                        <Viewbox Width="16" Height="16" Margin="8,0,0,0">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Path Data="{StaticResource IconChevR}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource OkBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#16A06A" Opacity="0.6" ShadowDepth="0" BlurRadius="6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Ready · Connected to Microsoft Intune" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Last sync: Never" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
