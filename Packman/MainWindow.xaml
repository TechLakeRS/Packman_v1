<Window x:Class="Packman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Packman.Views"
        mc:Ignorable="d"
        Title="PACKMAN — Create Package"
        Width="1320" Height="860"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UIFontFamily}"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ════════════ TOP BAR ════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LogoGradientBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#3B67F5" Opacity="0.42" ShadowDepth="4" BlurRadius="12" Direction="270"/>
                        </Border.Effect>
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconBox}" Stroke="White" StrokeThickness="1.9" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="PACKMAN" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}"/>
                </StackPanel>

                <!-- FREE pill -->
                <Border Grid.Column="1" Style="{StaticResource FreePill}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="FREE" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>

                <!-- Search -->
                <Border Grid.Column="2" Width="300" Height="38" CornerRadius="10"
                        Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Search applications, packages…" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{DynamicResource Muted2Brush}"/>
                    </StackPanel>
                </Border>

                <!-- Right side -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Docs -->
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,11,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Docs" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Theme -->
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="ThemeButton_Click" ToolTip="Toggle theme" Margin="0,0,11,0">
                        <Viewbox Width="17" Height="17">
                            <Path x:Name="ThemeIconPath" Data="{StaticResource IconMoon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Button>
                    <!-- Bell -->
                    <Button Style="{StaticResource IconButton}" Margin="0,0,11,0">
                        <Grid>
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <!-- Notification dot -->
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/>
                        </Grid>
                    </Button>
                    <!-- Avatar -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AvatarGradientBrush}">
                            <TextBlock Text="AD" FontWeight="ExtraBold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="admin.sarker" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Text="Contoso IT" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════ BODY (Sidebar + Content) ════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="226"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True" Margin="14,16">
                    <!-- Quota docked bottom -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Packages this month" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Free plan includes 25 / month" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource LineBrush}">
                                <Border Width="100" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock Text="15 of 25 used" FontSize="10.5" Foreground="{DynamicResource Muted2Brush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav stack -->
                    <StackPanel x:Name="NavStack">
                        <RadioButton Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.3" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Create Package" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource IconUpload}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Upload to Intune" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18">
                                    <Path Data="{StaticResource IconGrid}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Applications" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource IconMonitor}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Remote Test" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Sign" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconWrench}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Advanced" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="17" Height="17">
                                    <Path Data="{StaticResource IconGear}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel Margin="30,24,30,26">
                    <!-- Page header -->
                    <StackPanel>
                        <TextBlock Text="Create Package" Style="{StaticResource H1}"/>
                        <TextBlock Text="Build a new application package for Intune deployment" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Stepper -->
                    <Grid x:Name="StepperRoot" Margin="8,24,8,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Step 1 (Generate) -->
                        <Grid Grid.Column="0" Cursor="Hand" Background="Transparent" MouseDown="Stepper_Click" Tag="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="StepLineL0" Grid.Column="0" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="0,0,4,0" Visibility="Hidden"/>
                            <Border x:Name="StepLineR0" Grid.Column="2" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="4,0,0,0"/>
                            <Border x:Name="StepNode0" Grid.Column="1" Grid.Row="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="StepNum0" Text="1" FontSize="14" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox x:Name="StepCheck0" Width="15" Height="15" Visibility="Collapsed">
                                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <TextBlock x:Name="StepTitle0" Text="Generate" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StepSub0" Text="PSADT structure" FontSize="11" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- Step 2 (Edit) -->
                        <Grid Grid.Column="1" Cursor="Hand" Background="Transparent" MouseDown="Stepper_Click" Tag="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="StepLineL1" Grid.Column="0" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                            <Border x:Name="StepLineR1" Grid.Column="2" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="4,0,0,0"/>
                            <Border x:Name="StepNode1" Grid.Column="1" Grid.Row="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="StepNum1" Text="2" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox x:Name="StepCheck1" Width="15" Height="15" Visibility="Collapsed">
                                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <TextBlock x:Name="StepTitle1" Text="Edit Script" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StepSub1" Text="Optional" FontSize="11" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- Step 3 (Test) -->
                        <Grid Grid.Column="2" Cursor="Hand" Background="Transparent" MouseDown="Stepper_Click" Tag="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="StepLineL2" Grid.Column="0" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                            <Border x:Name="StepLineR2" Grid.Column="2" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="4,0,0,0"/>
                            <Border x:Name="StepNode2" Grid.Column="1" Grid.Row="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="StepNum2" Text="3" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox x:Name="StepCheck2" Width="15" Height="15" Visibility="Collapsed">
                                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <TextBlock x:Name="StepTitle2" Text="Remote Test" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StepSub2" Text="Optional" FontSize="11" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <!-- Step 4 (Upload) -->
                        <Grid Grid.Column="3" Cursor="Hand" Background="Transparent" MouseDown="Stepper_Click" Tag="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="StepLineL3" Grid.Column="0" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="0,0,4,0"/>
                            <Border x:Name="StepLineR3" Grid.Column="2" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource LineBrush}" Margin="4,0,0,0" Visibility="Hidden"/>
                            <Border x:Name="StepNode3" Grid.Column="1" Grid.Row="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2">
                                <Grid>
                                    <TextBlock x:Name="StepNum3" Text="4" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox x:Name="StepCheck3" Width="15" Height="15" Visibility="Collapsed">
                                        <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <TextBlock x:Name="StepTitle3" Text="Upload" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StepSub3" Text="Deploy to Intune" FontSize="11" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Step Stage (hosts the active step view) -->
                    <ContentPresenter x:Name="StageHost"/>

                    <!-- Footer -->
                    <Grid x:Name="FooterBar" Margin="0,18,0,0">
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                            <Grid>
                                <Button x:Name="BackBtn" Style="{StaticResource BackButton}" HorizontalAlignment="Left" Click="BackBtn_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16">
                                            <Path Data="{StaticResource IconChevL}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="Back" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SkipBtn" Style="{StaticResource SkipButton}" Content="Skip" Margin="0,0,10,0" Click="SkipBtn_Click" Visibility="Collapsed"/>
                                    <Button x:Name="PrimaryBtn" Style="{StaticResource PrimaryButton}" Click="PrimaryBtn_Click">
                                        <StackPanel x:Name="PrimaryBtnContent" Orientation="Horizontal">
                                            <TextBlock x:Name="PrimaryBtnLabel" Text="Generate Package" VerticalAlignment="Center"/>
                                            <Viewbox x:Name="PrimaryBtnChev" Width="16" Height="16" Margin="8,0,0,0">
                                                <Path Data="{StaticResource IconChevR}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════ STATUS BAR ════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource OkBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#16A06A" Opacity="0.6" ShadowDepth="0" BlurRadius="6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Ready · Connected to Microsoft Intune" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Last sync: Never" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
