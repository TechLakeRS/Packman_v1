<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Daylight palette. Same roles as the console theme with the surface ramp
         inverted: the window is the most recessed tone and panels are white.
         The accent darkens so it still carries text on a white panel. -->
    <Color x:Key="BgColor">#EDEFF3</Color>
    <Color x:Key="ShellColor">#F5F7FA</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="Card2Color">#FAFBFD</Color>
    <Color x:Key="RailColor">#F1F3F7</Color>
    <Color x:Key="LineColor">#DCE0E7</Color>
    <Color x:Key="Line2Color">#E9ECF1</Color>
    <Color x:Key="Line3Color">#E3E6EC</Color>
    <Color x:Key="EdgeColor">#C8CED8</Color>
    <Color x:Key="Edge2Color">#AEB6C3</Color>
    <Color x:Key="FieldColor">#FFFFFF</Color>
    <!-- Resting / hover surface for outlined controls. -->
    <Color x:Key="ControlColor">#F3F5F9</Color>
    <Color x:Key="ControlHoverColor">#E7EAF0</Color>

    <Color x:Key="InkColor">#0C1016</Color>
    <Color x:Key="TextColor">#171C25</Color>
    <Color x:Key="Text2Color">#333B47</Color>
    <!-- De-emphasis ramp. Every step here carries text, so each one clears
         WCAG AA (4.5:1) against the panel (worst is 5.15:1); MarkColor is the
         only value below that and is reserved for non-text marks. -->
    <Color x:Key="MutedColor">#47505E</Color>
    <Color x:Key="Muted2Color">#505967</Color>
    <Color x:Key="Muted3Color">#58616F</Color>
    <Color x:Key="DimColor">#5F6876</Color>
    <Color x:Key="Dim2Color">#656E7C</Color>
    <Color x:Key="FaintColor">#656E7C</Color>
    <Color x:Key="MarkColor">#A6AEBA</Color>

    <!-- oklch(0.78 0.16 148) / oklch(0.86 0.16 96) / oklch(0.66 0.19 27) -->
    <Color x:Key="OkColor">#1B7A31</Color>
    <Color x:Key="WarnColor">#7D6100</Color>
    <Color x:Key="BadColor">#C22B20</Color>
    <Color x:Key="DangerColor">#C22B20</Color>
    <Color x:Key="OkSoftColor">#1F1B7A31</Color>
    <Color x:Key="OkLineColor">#801B7A31</Color>
    <Color x:Key="WarnSoftColor">#1F7D6100</Color>
    <Color x:Key="WarnLineColor">#807D6100</Color>
    <Color x:Key="BadSoftColor">#1CC22B20</Color>
    <Color x:Key="BadLineColor">#80C22B20</Color>

    <!-- Accent. PrimaryFgColor is what sits on top of a filled accent block. -->
    <Color x:Key="PrimaryColor">#A2620B</Color>
    <Color x:Key="Primary2Color">#834E08</Color>
    <Color x:Key="PrimaryFgColor">#FFFFFF</Color>
    <Color x:Key="PrimaryFaintColor">#14A2620B</Color>
    <Color x:Key="PrimarySoftColor">#1FA2620B</Color>
    <Color x:Key="PrimaryDimColor">#33A2620B</Color>
    <Color x:Key="PrimaryLineColor">#80A2620B</Color>
    <Color x:Key="PrimaryGlowColor">#66A2620B</Color>

    <Color x:Key="CodeBgColor">#F7F8FB</Color>
    <Color x:Key="CodeTxtColor">#171C25</Color>
    <Color x:Key="CodeBarTxtColor">#47505E</Color>
    <Color x:Key="CodeCommentColor">#656E7C</Color>
    <Color x:Key="CodeKeywordColor">#A2620B</Color>
    <Color x:Key="CodeStringColor">#1B7A31</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}"/>
    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
    <SolidColorBrush x:Key="Line3Brush" Color="{StaticResource Line3Color}"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}"/>
    <SolidColorBrush x:Key="Edge2Brush" Color="{StaticResource Edge2Color}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}"/>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}"/>
    <SolidColorBrush x:Key="Muted3Brush" Color="{StaticResource Muted3Color}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}"/>
    <SolidColorBrush x:Key="Dim2Brush" Color="{StaticResource Dim2Color}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
    <!-- Dots, chevrons and idle rules only — never text. -->
    <SolidColorBrush x:Key="MarkBrush" Color="{StaticResource MarkColor}"/>

    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
    <SolidColorBrush x:Key="OkLineBrush" Color="{StaticResource OkLineColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="{StaticResource WarnLineColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}"/>
    <SolidColorBrush x:Key="BadLineBrush" Color="{StaticResource BadLineColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="Primary2Brush" Color="{StaticResource Primary2Color}"/>
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="{StaticResource PrimaryFgColor}"/>
    <SolidColorBrush x:Key="PrimaryFaintBrush" Color="{StaticResource PrimaryFaintColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimaryDimBrush" Color="{StaticResource PrimaryDimColor}"/>
    <SolidColorBrush x:Key="PrimaryLineBrush" Color="{StaticResource PrimaryLineColor}"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlowColor}"/>

    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="CodeTxtBrush" Color="{StaticResource CodeTxtColor}"/>
    <SolidColorBrush x:Key="CodeBarTxtBrush" Color="{StaticResource CodeBarTxtColor}"/>
    <SolidColorBrush x:Key="CodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>
    <SolidColorBrush x:Key="CodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="CodeStringBrush" Color="{StaticResource CodeStringColor}"/>

    <!-- The logo mark and avatar are flat blocks in this design, but the keys
         stay so existing view markup keeps resolving. -->
    <SolidColorBrush x:Key="LogoGradientBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AvatarGradientBrush" Color="#E5E9EF"/>

    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
