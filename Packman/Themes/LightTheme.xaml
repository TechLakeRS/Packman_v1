<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Theme tokens (light) -->
    <Color x:Key="BgColor">#F4F6FA</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="Card2Color">#FBFCFE</Color>
    <Color x:Key="LineColor">#E6EAF1</Color>
    <Color x:Key="Line2Color">#EEF1F6</Color>
    <Color x:Key="FieldColor">#F8FAFD</Color>
    <Color x:Key="InkColor">#0F1828</Color>
    <Color x:Key="TextColor">#26303F</Color>
    <Color x:Key="MutedColor">#647084</Color>
    <Color x:Key="Muted2Color">#9AA3B2</Color>
    <Color x:Key="OkColor">#16A06A</Color>
    <Color x:Key="OkSoftColor">#DEF2EA</Color>
    <Color x:Key="DangerColor">#E0552B</Color>

    <Color x:Key="PrimaryColor">#3B67F5</Color>
    <Color x:Key="Primary2Color">#2F52C4</Color>
    <Color x:Key="PrimaryDimColor">#E5EBFD</Color>
    <Color x:Key="PrimarySoftColor">#F1F4FE</Color>
    <Color x:Key="PrimaryGlowColor">#6B3B67F5</Color>

    <Color x:Key="CodeBgColor">#0C1322</Color>
    <Color x:Key="CodeTxtColor">#CDD9EE</Color>
    <Color x:Key="CodeBarTxtColor">#9FB0C9</Color>
    <Color x:Key="CodeCommentColor">#5D7290</Color>
    <Color x:Key="CodeKeywordColor">#7AA2FF</Color>
    <Color x:Key="CodeStringColor">#7FDCA0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="Primary2Brush" Color="{StaticResource Primary2Color}"/>
    <SolidColorBrush x:Key="PrimaryDimBrush" Color="{StaticResource PrimaryDimColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlowColor}"/>

    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="CodeTxtBrush" Color="{StaticResource CodeTxtColor}"/>
    <SolidColorBrush x:Key="CodeBarTxtBrush" Color="{StaticResource CodeBarTxtColor}"/>
    <SolidColorBrush x:Key="CodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>
    <SolidColorBrush x:Key="CodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="CodeStringBrush" Color="{StaticResource CodeStringColor}"/>

    <!-- Logo gradient: linear-gradient(150deg, var(--pri), color-mix(var(--pri) 55%, #fff)) -->
    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0.067,0" EndPoint="0.933,1">
        <GradientStop Color="#3B67F5" Offset="0"/>
        <GradientStop Color="#85A3F9" Offset="1"/>
    </LinearGradientBrush>

    <!-- Avatar gradient: linear-gradient(150deg, --pridim, --ln) -->
    <LinearGradientBrush x:Key="AvatarGradientBrush" StartPoint="0.067,0" EndPoint="0.933,1">
        <GradientStop Color="#E5EBFD" Offset="0"/>
        <GradientStop Color="#E6EAF1" Offset="1"/>
    </LinearGradientBrush>

    <!-- Theme name marker -->
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
</ResourceDictionary>
