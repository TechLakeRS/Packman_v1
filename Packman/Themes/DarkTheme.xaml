<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Theme tokens (dark) -->
    <Color x:Key="BgColor">#0B0F17</Color>
    <Color x:Key="CardColor">#141A26</Color>
    <Color x:Key="Card2Color">#10151F</Color>
    <Color x:Key="LineColor">#222B3B</Color>
    <Color x:Key="Line2Color">#1A2230</Color>
    <Color x:Key="FieldColor">#0D121B</Color>
    <Color x:Key="InkColor">#EEF2F8</Color>
    <Color x:Key="TextColor">#CDD5E2</Color>
    <Color x:Key="MutedColor">#8A94A8</Color>
    <Color x:Key="Muted2Color">#5B6577</Color>
    <Color x:Key="OkColor">#34D399</Color>
    <Color x:Key="OkSoftColor">#1F3837</Color>
    <Color x:Key="WarnColor">#E3A51A</Color>
    <Color x:Key="WarnSoftColor">#39301B</Color>
    <Color x:Key="BadColor">#F87171</Color>
    <Color x:Key="BadSoftColor">#3A2526</Color>
    <Color x:Key="DangerColor">#FF7A52</Color>

    <Color x:Key="PrimaryColor">#3B67F5</Color>
    <Color x:Key="Primary2Color">#2F52C4</Color>
    <Color x:Key="PrimaryDimColor">#192441</Color>
    <Color x:Key="PrimarySoftColor">#171F34</Color>
    <Color x:Key="PrimaryGlowColor">#6B3B67F5</Color>

    <Color x:Key="CodeBgColor">#070B13</Color>
    <Color x:Key="CodeTxtColor">#CDD9EE</Color>
    <Color x:Key="CodeBarTxtColor">#9FB0C9</Color>
    <Color x:Key="CodeCommentColor">#5D7290</Color>
    <Color x:Key="CodeKeywordColor">#7AA2FF</Color>
    <Color x:Key="CodeStringColor">#7FDCA0</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource Card2Color}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="{StaticResource Muted2Color}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="Primary2Brush" Color="{StaticResource Primary2Color}"/>
    <SolidColorBrush x:Key="PrimaryDimBrush" Color="{StaticResource PrimaryDimColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="{StaticResource PrimaryGlowColor}"/>

    <SolidColorBrush x:Key="CodeBgBrush" Color="{StaticResource CodeBgColor}"/>
    <SolidColorBrush x:Key="CodeTxtBrush" Color="{StaticResource CodeTxtColor}"/>
    <SolidColorBrush x:Key="CodeBarTxtBrush" Color="{StaticResource CodeBarTxtColor}"/>
    <SolidColorBrush x:Key="CodeCommentBrush" Color="{StaticResource CodeCommentColor}"/>
    <SolidColorBrush x:Key="CodeKeywordBrush" Color="{StaticResource CodeKeywordColor}"/>
    <SolidColorBrush x:Key="CodeStringBrush" Color="{StaticResource CodeStringColor}"/>

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0.067,0" EndPoint="0.933,1">
        <GradientStop Color="#3B67F5" Offset="0"/>
        <GradientStop Color="#85A3F9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AvatarGradientBrush" StartPoint="0.067,0" EndPoint="0.933,1">
        <GradientStop Color="#192441" Offset="0"/>
        <GradientStop Color="#222B3B" Offset="1"/>
    </LinearGradientBrush>

    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
</ResourceDictionary>
