<UserControl x:Class="Packman.Views.StepUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <!-- Two columns: the form stays put while publishing runs in the right rail. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ DEPLOY TO INTUNE ═══════════ -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Text="DEPLOY TO INTUNE" Style="{StaticResource SectionLabel}"/>
                <TextBlock DockPanel.Dock="Right" Text="build .intunewin and publish" Style="{StaticResource Caption}"/>
                <Border Style="{StaticResource Rule}"/>
            </DockPanel>

            <!-- App summary strip -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="0">
                <Grid>
                    <Border Width="2" HorizontalAlignment="Left" Background="{DynamicResource PrimaryBrush}"/>
                    <DockPanel Margin="16,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Upload.ReviewSize}" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                        <TextBlock Text="{Binding Upload.AppSummaryName}" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="{Binding Upload.AppSummaryDetail}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource Muted2Brush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Detection -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Detection method" Style="{StaticResource FieldLabel}"/>
                <ComboBox Margin="0,6,0,0" Height="34"
                          ItemsSource="{Binding Upload.DetectionMethods}"
                          SelectedItem="{Binding Upload.SelectedDetectionMethod, Mode=TwoWay}"/>

                <Grid Margin="0,12,0,0" Visibility="{Binding Upload.IsCustomDetection, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Path / Key / Product code" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Margin="0,6,0,0"
                                 Text="{Binding Upload.DetectionPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="File / Value name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Margin="0,6,0,0"
                                 Text="{Binding Upload.DetectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Version / Value" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Margin="0,6,0,0"
                                 Text="{Binding Upload.DetectionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border BorderBrush="{DynamicResource PrimaryLineBrush}" BorderThickness="1" Padding="7,4" VerticalAlignment="Top">
                        <TextBlock Text="RULE" FontFamily="{StaticResource LabelFontFamily}" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Upload.DetectionSummary}" Margin="9,0,0,0" MaxWidth="520"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" LineHeight="18"
                               Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Requirements -->
            <Border Height="1" Background="{DynamicResource Line3Brush}" Margin="0,22,0,0"/>
            <ToggleButton x:Name="RequirementsToggle" Cursor="Hand" HorizontalAlignment="Left"
                          Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9" Foreground="{DynamicResource Muted2Brush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25B8;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="Text" Value="&#x25BE;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="REQUIREMENTS &amp; RETURN CODES" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource LabelFontFamily}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBlock Text="pre-filled from Settings ▸ Intune Defaults" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="11.5" Foreground="{DynamicResource DimBrush}"/>
                        </StackPanel>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <StackPanel Margin="0,14,0,0"
                        Visibility="{Binding IsChecked, ElementName=RequirementsToggle, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Minimum OS" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Margin="0,6,0,0"
                                  ItemsSource="{Binding Upload.OperatingSystems}"
                                  SelectedItem="{Binding Upload.SelectedOperatingSystem, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Disk (MB)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Height="32" Margin="0,6,0,0"
                                 local:PlaceholderText.Text="any"
                                 Text="{Binding Upload.MinFreeDiskSpaceMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Memory (MB)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Height="32" Margin="0,6,0,0"
                                 local:PlaceholderText.Text="any"
                                 Text="{Binding Upload.MinMemoryMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="CPU (MHz)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoField}" Height="32" Margin="0,6,0,0"
                                 local:PlaceholderText.Text="any"
                                 Text="{Binding Upload.MinCpuSpeedMHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock Text="Processors" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource MonoField}" Width="110" Height="32" Margin="12,0,0,0"
                             local:PlaceholderText.Text="any"
                             Text="{Binding Upload.MinProcessors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Return codes -->
                <DockPanel Margin="0,20,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="RETURN CODES" Style="{StaticResource SectionLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="RESET TO DEFAULTS"
                            Padding="9,5" Command="{Binding Upload.RestoreDefaultsCommand}"
                            ToolTip="Reload the values from Settings ▸ Intune Defaults"/>
                    <Border Style="{StaticResource Rule}"/>
                </DockPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource MonoField}"
                             local:PlaceholderText.Text="Exit code, e.g. 1707"
                             Text="{Binding Upload.NewReturnCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="ADD"
                            Command="{Binding Upload.AddReturnCodeCommand}"/>
                </Grid>

                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Upload.ReturnCodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource Line2Brush}"
                                        BorderThickness="0,0,0,1" Padding="13,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Code}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource ContextToggle}" Padding="9,6" Content="SUCCESS" IsChecked="{Binding IsSuccess}"/>
                                                <RadioButton Style="{StaticResource ContextToggle}" Padding="9,6" Content="SOFT REBOOT" IsChecked="{Binding IsSoftReboot}"/>
                                                <RadioButton Style="{StaticResource ContextToggle}" Padding="9,6" Content="HARD REBOOT" IsChecked="{Binding IsHardReboot}"/>
                                                <RadioButton Style="{StaticResource ContextToggle}" Padding="9,6" Content="RETRY" IsChecked="{Binding IsRetry}"/>
                                                <RadioButton Style="{StaticResource ContextToggle}" Padding="9,6" Content="FAILED" IsChecked="{Binding IsFailed}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}"
                                                VerticalAlignment="Center" ToolTip="Remove" Content="✕" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Sign-in state -->
            <Border BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="2,0,0,0" Background="{DynamicResource CardBrush}"
                    Padding="13,10" Margin="0,18,0,0"
                    Visibility="{Binding Upload.IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"
                           Text="Not signed in to Intune. Open Settings and sign in before uploading."/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                        Visibility="{Binding Upload.IsSignedIn, Converter={StaticResource BoolToVis}}">
                <Rectangle Width="6" Height="6" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{DynamicResource Muted2Brush}">
                    <Run Text="Signed in as"/>
                    <Run Text="{Binding Upload.SignedInUser, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{Binding Upload.StatusText}" Margin="0,12,0,0" TextWrapping="Wrap"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11" LineHeight="17"
                       Foreground="{DynamicResource DimBrush}"/>
        </StackPanel>

        <!-- ═══════════ REVIEW / PUBLISHING ═══════════ -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Left" Text="REVIEW" Style="{StaticResource SectionLabel}"/>
                <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
            </DockPanel>

            <TextBlock Text="Name in Intune" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource TextField}" Margin="0,6,0,0"
                     Text="{Binding Upload.IntuneDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Margin="0,14,0,0">
                <ContentControl Style="{StaticResource DlRow}" Tag="App name" Content="{Binding Upload.ReviewName}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Vendor" Content="{Binding Upload.ReviewVendor}"/>
                <ContentControl Style="{StaticResource DlRowMono}" Tag="Version" Content="{Binding Upload.ReviewVersion}"/>
                <ContentControl Style="{StaticResource DlRowMono}" Tag="Author" Content="{Binding Upload.ReviewAuthor}"/>
                <ContentControl Style="{StaticResource DlRowMono}" Tag="Architecture" Content="{Binding Upload.ReviewArchitecture}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Context" Content="{Binding Upload.ReviewContext}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Type" Content="{Binding Upload.ReviewPackageType}"/>
                <ContentControl Style="{StaticResource DlRowMono}" Tag="Size" Content="{Binding Upload.ReviewSize}"/>
            </StackPanel>

            <!-- Pre-flight, shown until publishing starts -->
            <StackPanel Visibility="{Binding Upload.IsNotPublishing, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,26,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="WHAT HAPPENS ON UPLOAD" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Rule}" Margin="12,0,0,0"/>
                </DockPanel>
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock" x:Key="Num">
                            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="LineHeight" Value="19"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="Body">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="LineHeight" Value="19"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="12,0,0,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <TextBlock Text="01" Style="{StaticResource Num}"/>
                        <TextBlock Text="Sign the PSADT script (if code signing is enabled in Settings)." Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <TextBlock Text="02" Style="{StaticResource Num}"/>
                        <TextBlock Text="Build the .intunewin with IntuneWinAppUtil." Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <TextBlock Text="03" Style="{StaticResource Num}"/>
                        <TextBlock Text="Register the Win32 app, upload content to Azure, and publish." Style="{StaticResource Body}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="04" Style="{StaticResource Num}"/>
                        <TextBlock Text="Write a supersedence relationship when this is an upgrade." Style="{StaticResource Body}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Live publish state -->
            <StackPanel Visibility="{Binding Upload.IsPublishing, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,26,0,14">
                    <TextBlock DockPanel.Dock="Left" Text="PUBLISHING" Style="{StaticResource SectionLabel}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Upload.TenantName}" Style="{StaticResource Caption}"/>
                    <Border Style="{StaticResource Rule}"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <Grid Width="30" Height="30" VerticalAlignment="Top">
                        <!-- running: rotating arc -->
                        <Grid Visibility="{Binding Upload.IsRunning, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Name="Spin">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Spin"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Width="30" Height="30" Stroke="{DynamicResource EdgeBrush}" StrokeThickness="2"/>
                            <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M15,1 A14,14 0 0 1 29,15"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource OkBrush}" BorderThickness="1.5"
                                Visibility="{Binding Upload.IsSucceeded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#x2713;" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border BorderBrush="{DynamicResource BadBrush}" BorderThickness="1.5"
                                Visibility="{Binding Upload.IsFailed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#x2715;" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BadBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                        <TextBlock Text="{Binding Upload.PublishTitle}" FontSize="14.5" FontWeight="Bold" LineHeight="19"
                                   Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Upload.StatusText}" Margin="0,5,0,0" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5" LineHeight="15"
                                   Foreground="{DynamicResource Muted2Brush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Progress rail -->
                <Border Height="3" Background="{DynamicResource Line2Brush}" Margin="0,16,0,0">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Upload.ProgressValue}" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource PrimaryBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Upload.IsSucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                        <Setter Property="Value" Value="100"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Upload.IsFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                        <Setter Property="Value" Value="100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </Border>

                <!-- Step list -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Upload.PublishSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="2,0,0,1" Padding="12,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}"/>
                                                    <Setter Property="Background" Value="{DynamicResource BadSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Number}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Text" Value="&#x2713;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Text" Value="&#x2715;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="11,0,0,0" VerticalAlignment="Center"
                                                   FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted3Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource LabelFontFamily}" FontSize="8.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{Binding Upload.ResultText}" Margin="0,14,0,0" TextWrapping="Wrap"
                           FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5" LineHeight="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Upload.IsFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Style="{StaticResource GhostButton}" Content="DONE" HorizontalAlignment="Stretch" Margin="0,14,0,0"
                        Command="{Binding Upload.DoneCommand}"
                        Visibility="{Binding Upload.IsComplete, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
