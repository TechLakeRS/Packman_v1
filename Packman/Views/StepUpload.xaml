<UserControl x:Class="Packman.Views.StepUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>

        <!-- ============ FORM (hidden while publishing) ============ -->
        <Grid Visibility="{Binding Upload.IsNotPublishing, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Deploy to Intune card -->
        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconRocket}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Deploy to Intune" Style="{StaticResource H2}"/>
                        <TextBlock Text="Build the .intunewin package and publish" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- App summary -->
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding Upload.AppSummaryName}" FontSize="14.5" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="{Binding Upload.AppSummaryDetail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Detection method -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Detection method" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ComboBox Height="40" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Upload.DetectionMethods}"
                              SelectedItem="{Binding Upload.SelectedDetectionMethod, Mode=TwoWay}"/>

                    <!-- Editable fields for a custom method -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding Upload.IsCustomDetection, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Path / Key / Product code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource TextField}" Margin="0,6,0,0" Padding="13,12"
                                     Text="{Binding Upload.DetectionPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="File / Value name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource TextField}" Margin="0,6,0,0" Padding="13,12"
                                     Text="{Binding Upload.DetectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Version / Value" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource TextField}" Margin="0,6,0,0" Padding="13,12"
                                     Text="{Binding Upload.DetectionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Upload.DetectionSummary}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Requirements (collapsed; defaults used when unset) -->
                <StackPanel Margin="0,16,0,0">
                    <ToggleButton x:Name="RequirementsToggle" Cursor="Hand" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                        <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" Fill="Transparent"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconChevR}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconChevD}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Viewbox>
                                    <TextBlock Text="Requirements" Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="optional — defaults applied when left blank" Margin="9,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding IsChecked, ElementName=RequirementsToggle, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimum OS" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Margin="0,6,0,0" Height="40" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Upload.OperatingSystems}"
                                      SelectedItem="{Binding Upload.SelectedOperatingSystem, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Free disk (MB)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource TextField}" Width="110" Margin="0,6,0,0" Padding="13,12"
                                     local:PlaceholderText.Text="any"
                                     Text="{Binding Upload.MinFreeDiskSpaceMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Memory (MB)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource TextField}" Width="110" Margin="0,6,0,0" Padding="13,12"
                                     local:PlaceholderText.Text="any"
                                     Text="{Binding Upload.MinMemoryMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Sign-in required notice -->
                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,16,0,0"
                        Visibility="{Binding Upload.IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Text="Not signed in to Intune. Open Settings and sign in before uploading."/>
                </Border>

                <!-- Signed-in user -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                            Visibility="{Binding Upload.IsSignedIn, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                    <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                        <Run Text="Signed in as "/>
                        <Run Text="{Binding Upload.SignedInUser, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Progress -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding Upload.IsUploading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Upload.ProgressValue}"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock Text="{Binding Upload.StatusText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Review + pre-flight column -->
        <StackPanel Grid.Column="2">

        <!-- Review card -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Review" Style="{StaticResource H2}" FontSize="13.5" Margin="0,0,0,8"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="App name" Content="{Binding Upload.ReviewName}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Vendor" Content="{Binding Upload.ReviewVendor}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Version" Content="{Binding Upload.ReviewVersion}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Author" Content="{Binding Upload.ReviewAuthor}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Architecture" Content="{Binding Upload.ReviewArchitecture}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Context" Content="{Binding Upload.ReviewContext}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Type" Content="{Binding Upload.ReviewPackageType}"/>
                <ContentControl Style="{StaticResource DlRow}" Tag="Size" Content="{Binding Upload.ReviewSize}"/>
            </StackPanel>
        </Border>

        <!-- Pre-flight card -->
        <Border Style="{StaticResource CardSoft}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="What happens on upload" Style="{StaticResource H2}" FontSize="13.5" Margin="0,0,0,14"/>

                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" LineStackingStrategy="BlockLineHeight">
                    <Run Text="1. Sign the PSADT script (if code signing is enabled in Settings)."/>
                    <LineBreak/>
                    <Run Text="2. Build the .intunewin with IntuneWinAppUtil."/>
                    <LineBreak/>
                    <Run Text="3. Register the Win32 app, upload content to Azure, and publish."/>
                    <LineBreak/>
                    <Run Text="4. Write a supersedence relationship when this is an upgrade."/>
                </TextBlock>

                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,16,0,0">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                               Text="Click Build &amp; Upload below to start. Upload runs in the background; progress is shown here."/>
                </Border>
            </StackPanel>
        </Border>

        </StackPanel>
        </Grid>

        <!-- ============ PUBLISHING OVERLAY ============ -->
        <Grid MinHeight="560" Background="{DynamicResource BgBrush}"
              Visibility="{Binding Upload.IsPublishing, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="560" VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Spinner (running) -->
                <Viewbox Width="56" Height="56" HorizontalAlignment="Center"
                         Visibility="{Binding Upload.IsRunning, Converter={StaticResource BoolToVis}}">
                    <Grid Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Name="Spin">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Spin"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Width="44" Height="44" Stroke="{DynamicResource LineBrush}" StrokeThickness="4"/>
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M22,2 A20,20 0 0 1 42,22"/>
                    </Grid>
                </Viewbox>

                <!-- Done check (complete & success) -->
                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource OkSoftBrush}" HorizontalAlignment="Center"
                        Visibility="{Binding Upload.IsSucceeded, Converter={StaticResource BoolToVis}}">
                    <Viewbox Width="22" Height="22">
                        <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>

                <!-- Error mark (complete & failed) -->
                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource BadSoftBrush}" HorizontalAlignment="Center"
                        Visibility="{Binding Upload.IsFailed, Converter={StaticResource BoolToVis}}">
                    <Viewbox Width="20" Height="20">
                        <Path Data="{StaticResource IconX}" Stroke="{DynamicResource BadBrush}" StrokeThickness="2.4" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>

                <TextBlock Text="{Binding Upload.PublishTitle}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Building the Win32 package and pushing to Microsoft Intune. This usually takes ~30 seconds — keep this tab open."
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding Upload.IsRunning, Converter={StaticResource BoolToVis}}"/>

                <!-- Steps -->
                <ItemsControl ItemsSource="{Binding Upload.PublishSteps}" Margin="0,24,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="16,14" Margin="0,0,0,10"
                                    Background="{DynamicResource CardBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- status circle -->
                                    <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                        <!-- done -->
                                        <Border CornerRadius="13" Background="{DynamicResource OkBrush}" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                            <Viewbox Width="13" Height="13">
                                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <!-- working -->
                                        <Border CornerRadius="13" Background="{DynamicResource PrimaryBrush}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                                        <!-- error -->
                                        <Border CornerRadius="13" Background="{DynamicResource BadBrush}" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                            <Viewbox Width="12" Height="12">
                                                <Path Data="{StaticResource IconX}" Stroke="White" StrokeThickness="2.4" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <!-- pending -->
                                        <Border CornerRadius="13" Background="{DynamicResource Line2Brush}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="13,0,0,0" VerticalAlignment="Center"
                                               FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Result + Done -->
                <StackPanel Visibility="{Binding Upload.IsComplete, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Upload.ResultText}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                            Command="{Binding Upload.DoneCommand}" Content="Done"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
