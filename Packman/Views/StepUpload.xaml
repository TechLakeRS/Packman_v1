<UserControl x:Class="Packman.Views.StepUpload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Deploy to Intune card -->
        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconRocket}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Deploy to Intune" Style="{StaticResource H2}"/>
                        <TextBlock Text="Build the .intunewin package and publish" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Summary chip -->
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource LogoGradientBrush}">
                            <TextBlock Text="F" FontWeight="ExtraBold" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mozilla Firefox" FontSize="14.5" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="v124.0.1 · System context · Win32" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource OkSoftBrush}" CornerRadius="8" Padding="11,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13">
                                    <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Ready" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OkBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Assignment groups -->
                <StackPanel Margin="0,18,0,0">
                    <TextBlock Text="Assignment groups" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="9" MinHeight="48">
                        <WrapPanel>
                            <!-- Chip 1 -->
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6,7,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="All Pilot Devices" Margin="8,0,8,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                    <Border Width="17" Height="17" CornerRadius="5" Background="Transparent">
                                        <Viewbox Width="11" Height="11">
                                            <Path Data="{StaticResource IconX}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Chip 2 -->
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="11,6,7,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="IT — Workstations" Margin="8,0,8,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                    <Border Width="17" Height="17" CornerRadius="5" Background="Transparent">
                                        <Viewbox Width="11" Height="11">
                                            <Path Data="{StaticResource IconX}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Input -->
                            <TextBox MinWidth="160" VerticalAlignment="Center" Padding="5" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource UIFontFamily}" FontSize="13" Foreground="{DynamicResource InkBrush}" local:PlaceholderText.Text="Add Entra group…"/>
                        </WrapPanel>
                    </Border>
                    <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0">
                        <Run Text="Assigned as "/>
                        <Run FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="Required"/>
                        <Run Text=". Members receive the app automatically."/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Pre-flight card -->
        <Border Grid.Column="2" Style="{StaticResource CardSoft}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Pre-flight" Style="{StaticResource H2}" FontSize="13.5" Margin="0,0,0,14"/>

                <!-- Pre-flight done items -->
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource OkBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1">
                        <Viewbox Width="12" Height="12">
                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Package signed with Authenticode" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Margin="0,9,0,0"/>

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource OkBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1">
                        <Viewbox Width="12" Height="12">
                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Detection rule generated" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Margin="0,9,0,0"/>

                <!-- Pending items -->
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="1" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text=".intunewin build" Margin="11,0,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1" Margin="0,9,0,0"/>

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <TextBlock Text="2" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Muted2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Published to tenant" Margin="11,0,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Tip -->
                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Path Data="{StaticResource IconBulb}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight">
                            <Run Text="Connected to "/>
                            <Run FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="Contoso"/>
                            <Run Text=" tenant. Upload takes ~30s for a typical Win32 app."/>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
