<UserControl x:Class="Packman.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Packman"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationsViewModel}"
             FontFamily="{StaticResource UIFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,26">

            <!-- Header -->
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Applications" Style="{StaticResource H1}"/>
                    <TextBlock Text="Browse and manage every package in your library" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Reload from Intune">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tools: search + manufacturer / category / updated-within filters -->
            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MinWidth="180">
                    <TextBox Style="{StaticResource TextField}" Height="40"
                             local:PlaceholderText.Text="Search applications…"
                             Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Grid>

                <ComboBox Grid.Column="1" Width="200" Height="40" Margin="14,0,0,0"
                          ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}"/>
                <ComboBox Grid.Column="2" Width="185" Height="40" Margin="14,0,0,0"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                <ComboBox Grid.Column="3" Width="185" Height="40" Margin="14,0,0,0"
                          ItemsSource="{Binding UpdatedWindows}" SelectedItem="{Binding SelectedUpdatedWindow, Mode=TwoWay}"/>
            </Grid>

            <!-- Table card -->
            <Border Style="{StaticResource Card}" Padding="0" Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <!-- Header row: Application / Updated sort on click -->
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ver"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Upd"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Breadcrumb}" Command="{Binding SortByNameCommand}"
                                FontSize="11" FontWeight="ExtraBold" ToolTip="Sort by name">
                            <TextBlock Text="{Binding NameHeader}"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource ColHead}"/>
                        <Button Grid.Column="2" Style="{StaticResource Breadcrumb}" Command="{Binding SortByUpdatedCommand}"
                                FontSize="11" FontWeight="ExtraBold" Margin="0,0,18,0" ToolTip="Sort by last updated">
                            <TextBlock Text="{Binding UpdatedHeader}"/>
                        </Button>
                        <TextBlock Grid.Column="3" Text=""/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding Page}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="rb" Background="Transparent" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rb" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Margin="18,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Ver"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Upd"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="9" Background="{Binding TileColor, Converter={StaticResource HexToBrush}}">
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="ExtraBold" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                                    <!-- Publishing warning: only visible when the upload isn't fully published -->
                                                    <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="8" Padding="7,1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowStateWarning, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StateWarningText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource WarnBrush}" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Publisher}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Version -->
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" Margin="18,0"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>

                                        <!-- Updated -->
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedText}" VerticalAlignment="Center" Margin="0,0,18,0"
                                                   FontSize="13" Foreground="{DynamicResource MutedBrush}"/>

                                        <!-- Chevron affordance -->
                                        <Viewbox Grid.Column="3" Width="14" Height="14" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChevR}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Loading / empty -->
                    <StackPanel Margin="18,34" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="40" Height="40" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="4"
                                 StrokeDashArray="22 8" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding LoadStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="18,28" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No applications to show" Foreground="{DynamicResource InkBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Not connected: prompt the user to connect on Settings first -->
                    <StackPanel Margin="18,40" HorizontalAlignment="Center"
                                Visibility="{Binding ShowConnectPrompt, Converter={StaticResource BoolToVis}}">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource PrimaryDimBrush}" HorizontalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Not connected to Microsoft Intune" Foreground="{DynamicResource InkBrush}" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Connect to your tenant on the Settings page to browse applications from Intune."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Go to Settings to connect" VerticalAlignment="Center"/>
                                <Viewbox Width="14" Height="14" Margin="8,0,0,0">
                                    <Path Data="{StaticResource IconChevR}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pagination footer -->
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12"
                            Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding PrevPageCommand}" Padding="12,0" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,5,0"><Path Data="{StaticResource IconChevL}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="14,0" FontSize="12.5"
                                           FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding NextPageCommand}" Padding="12,0" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                                        <Viewbox Width="13" Height="13" Margin="5,0,0,0"><Path Data="{StaticResource IconChevR}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
