<UserControl x:Class="Packman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Packman"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource H1}"/>
                <TextBlock Text="Configure your packaging environment, authentication and integrations"
                           Style="{StaticResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Version pill -->
                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="20" Padding="12,5" Margin="0,0,10,0">
                    <TextBlock Text="v1.0.0" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <!-- Reset -->
                <Button Style="{StaticResource GhostButton}" Command="{Binding ResetCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Reset" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Save Settings -->
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ Two-column body ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="268"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: scrollable sections ──────────────────────────── -->
            <ScrollViewer x:Name="LeftScroll" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Authentication card -->
                    <Border x:Name="AuthCard" Style="{StaticResource Card}">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Authentication" Style="{StaticResource H2}"/>
                                    <TextBlock Text="How EPS connects to Microsoft Intune &amp; Entra ID" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Auth mode tab bar (Interactive | App Registration) -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="4">
                                <UniformGrid Rows="1">
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup"
                                                 IsChecked="{Binding IsInteractive}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="{StaticResource IconUser}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="Interactive" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup" Margin="4,0,0,0"
                                                 IsChecked="{Binding IsAppRegistration}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14">
                                                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                            <TextBlock Text="App Registration" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>

                            <!-- Interactive panel -->
                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="optional" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,2" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBox Style="{StaticResource TextField}"
                                             Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="contoso.onmicrosoft.com or tenant GUID"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconBuilding}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>

                                <!-- Browser sign-in row -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="16,14" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource PrimaryDimBrush}" Margin="0,0,14,0">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource IconGrid}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Browser sign-in" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="You'll be redirected to Microsoft to authenticate" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Not signed in status -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                                    Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Text="Not signed in" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Signed in status -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource OkBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding SignedInUser}" FontSize="12.5" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Sign in button -->
                                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding SignInCommand}"
                                                Visibility="{Binding IsNotSignedIn, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                                    <Path Data="{StaticResource IconChevR}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Sign in" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Sign out button -->
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Command="{Binding SignOutCommand}"
                                                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Sign out" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- App Registration panel -->
                            <StackPanel Margin="0,18,0,0"
                                        Visibility="{Binding IsAppRegistration, Converter={StaticResource BoolToVis}}">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tenant ID -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}"
                                                     Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="00000000-0000-0000-0000-000000000000"/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconBuilding}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Application (Client) ID -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Application (Client) ID" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text=" *" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}"
                                                     Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="Application (Client) ID"/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconApp}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Certificate source -->
                                <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource"
                                                     IsChecked="{Binding AuthUseStoreCert}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Select from store" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource" Margin="3,0,0,0"
                                                     IsChecked="{Binding AuthUseManualThumbprint}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Enter thumbprint" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <!-- Store cert picker -->
                                <ComboBox Margin="0,10,0,0"
                                          ItemsSource="{Binding AvailableCertificates}"
                                          SelectedItem="{Binding SelectedAuthCert}"
                                          Visibility="{Binding AuthUseStoreCert, Converter={StaticResource BoolToVis}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Manual thumbprint -->
                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding AuthUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                                    <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                             Text="{Binding AuthThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="40-char SHA-1 thumbprint"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>

                                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                                    <Run Text="Certificate must be installed in the"/>
                                    <Run Text=" CurrentUser\My " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="store on this machine."/>
                                </TextBlock>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Code Signing card -->
                    <Border x:Name="CodeSignCard" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>

                            <!-- Card header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Code Signing" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Authenticode certificate used to sign packaged applications" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Enable / Disable toggle -->
                                <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable"
                                                     IsChecked="{Binding CodeSigningDisabled}">
                                            <TextBlock Text="Disabled" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable" Margin="3,0,0,0"
                                                     IsChecked="{Binding CodeSigningEnabled}">
                                            <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Disabled placeholder -->
                            <TextBlock Visibility="{Binding CodeSigningDisabled, Converter={StaticResource BoolToVis}}"
                                       FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                       Text="Code signing is disabled. Packages will not be Authenticode-signed."/>

                            <!-- Enabled: cert source + fields -->
                            <StackPanel Visibility="{Binding CodeSigningEnabled, Converter={StaticResource BoolToVis}}">

                                <!-- Cert source toggle -->
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource"
                                                     IsChecked="{Binding CodeSignUseStoreCert}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Select from store" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource" Margin="3,0,0,0"
                                                     IsChecked="{Binding CodeSignUseManualThumbprint}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="13" Height="13">
                                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                                <TextBlock Text="Enter manually" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <!-- Store picker -->
                                <ComboBox Margin="0,0,0,14"
                                          ItemsSource="{Binding AvailableCertificates}"
                                          SelectedItem="{Binding SelectedCodeSignCert}"
                                          Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Manual fields: Certificate Name + Subject + Thumbprint + Timestamp -->
                                <Grid Visibility="{Binding CodeSignUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Name + Subject -->
                                    <StackPanel Grid.Column="0" Grid.Row="0">
                                        <TextBlock Text="Certificate Name" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}"
                                                     Text="{Binding CodeSignCertName, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="Friendly name"/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconTag}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="{DynamicResource Muted2Brush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="0">
                                        <TextBlock Text="Certificate Subject" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}"
                                                     Text="{Binding CodeSignCertSubject, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="CN=Company, O=..."/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2: Thumbprint + Timestamp -->
                                    <StackPanel Grid.Column="0" Grid.Row="2">
                                        <TextBlock Text="Certificate Thumbprint" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                                     Text="{Binding CodeSignThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="SHA-1 thumbprint"/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Grid.Row="2">
                                        <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBox Style="{StaticResource TextField}"
                                                     Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}"
                                                     local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Viewbox>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Timestamp for store mode -->
                                <StackPanel Margin="0,0,0,0"
                                            Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,7,0,0">
                                        <TextBox Style="{StaticResource TextField}"
                                                 Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}"
                                                 local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                                        <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                            <Path Data="{StaticResource IconBell}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                    </Grid>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Network Paths card -->
                    <Border x:Name="NetworkPathsCard" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Network Paths" Style="{StaticResource H2}"/>
                                    <TextBlock Text="File share locations for package output and PSADT template" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Intune Applications output path -->
                            <TextBlock Text="Intune Applications Path" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,7,0,0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding IntuneApplicationsPath, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="\\server\share\IntuneApps"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>

                            <!-- PSADT Template path -->
                            <TextBlock Text="PSADT Template Path" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                            <Grid Margin="0,7,0,0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding PSADTTemplatePath, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="\\server\share\PSADTTemplate"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>

                            <!-- IntuneWinAppUtil path -->
                            <TextBlock Text="IntuneWinAppUtil Path" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                            <Grid Margin="0,7,0,0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding IntuneWinAppUtilPath, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="\\server\share\Tools\IntuneWinAppUtil.exe"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Group Assignment card -->
                    <Border x:Name="GroupAssignmentCard" Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>

                            <!-- Card header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Group Assignment" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Assign uploaded packages to Entra ID groups automatically" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- ── Per-package group ──────────────────────────── -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Create a new group for each package" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="A fresh security group is created on every upload and assigned to the app" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- On / Off toggle -->
                                <Border Grid.Column="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage"
                                                     IsChecked="{Binding CreateGroupPerPackageDisabled}">
                                            <TextBlock Text="Off" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="GroupPerPackage" Margin="3,0,0,0"
                                                     IsChecked="{Binding CreateGroupPerPackage}">
                                            <TextBlock Text="On" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Naming template + intent (only when On) -->
                            <StackPanel Visibility="{Binding CreateGroupPerPackage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Group name template" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,7,0,0">
                                    <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                             Text="{Binding GroupNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="%vendor%_%appName%_%appVersion%"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconTag}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="{DynamicResource Muted2Brush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Tokens:"/>
                                    <Run Text=" %vendor% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="%appName% " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="%appVersion%" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text="  ·  Example: "/>
                                    <Run Text="{Binding GroupNamePreview, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                </TextBlock>

                                <!-- Assignment intent for the new group -->
                                <TextBlock Text="Assignment type" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="NewGroupIntent"
                                                     IsChecked="{Binding NewGroupAvailable}">
                                            <TextBlock Text="Available" VerticalAlignment="Center"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ContextToggle}" GroupName="NewGroupIntent" Margin="3,0,0,0"
                                                     IsChecked="{Binding NewGroupRequired}">
                                            <TextBlock Text="Required" VerticalAlignment="Center"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,18,0,18"/>

                            <!-- ── Existing groups ────────────────────────────── -->
                            <TextBlock Text="Always assign these existing groups" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Every upload is also assigned to the groups listed below" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,12"/>

                            <!-- Add group row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox Style="{StaticResource TextField}"
                                             Text="{Binding NewGroupNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             local:PlaceholderText.Text="Entra ID group display name"/>
                                    <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                        <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding AddGroupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                            <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="Add" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Group rows -->
                            <ItemsControl ItemsSource="{Binding ExistingGroups}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1" CornerRadius="11" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GroupName}" VerticalAlignment="Center"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                                <!-- Intent toggle -->
                                                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                                        BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource ContextToggle}"
                                                                     IsChecked="{Binding IsAvailable}">
                                                            <TextBlock Text="Available" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                        <RadioButton Style="{StaticResource ContextToggle}" Margin="3,0,0,0"
                                                                     IsChecked="{Binding IsRequired}">
                                                            <TextBlock Text="Required" VerticalAlignment="Center"/>
                                                        </RadioButton>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Remove -->
                                                <Button Grid.Column="2" Style="{StaticResource RowIconButton}" Command="{Binding RemoveCommand}"
                                                        VerticalAlignment="Center" ToolTip="Remove">
                                                    <Viewbox Width="15" Height="15">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Viewbox>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                    <!-- bottom padding -->
                    <Border Height="16"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Right: sections nav ─────────────────────────────────── -->
            <StackPanel Grid.Column="2">

                <!-- First-run setup card -->
                <Border Style="{StaticResource CardSoft}" BorderBrush="{DynamicResource PrimaryDimBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                <Path Data="{StaticResource IconBulb}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="First-run setup" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" LineHeight="18">
                            Complete authentication and network paths, then save. This flag is cleared automatically once configuration is valid.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Sections nav card -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="16,14,16,8">
                            <TextBlock Text="Sections" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Jump to a configuration area" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource LineBrush}"/>
                        <!-- Authentication (active) -->
                        <Border Cursor="Hand" MouseLeftButtonUp="NavAuth_Click"
                                Background="{DynamicResource PrimaryDimBrush}" Padding="16,11">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Authentication" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <!-- Code Signing -->
                        <Border Cursor="Hand" MouseLeftButtonUp="NavCodeSign_Click" Padding="16,11">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Code Signing" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <!-- Network Paths -->
                        <Border Cursor="Hand" MouseLeftButtonUp="NavNetworkPaths_Click" Padding="16,11">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Network Paths" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <!-- Greyed-out future sections -->
                        <Border Padding="16,11" Opacity="0.4">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconMonitor}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="WDAC Hyper-V" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16,11" Opacity="0.4">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="GitLab" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Cursor="Hand" MouseLeftButtonUp="NavGroupAssignment_Click" Padding="16,11">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconGroup}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Group Assignment" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16,11" Opacity="0.4">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconGear}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Key Vault Caching" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Save status -->
                <TextBlock Text="{Binding SaveStatus}" FontSize="12.5" Foreground="{DynamicResource OkBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
