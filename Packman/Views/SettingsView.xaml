<UserControl x:Class="Packman.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Packman"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             FontFamily="{StaticResource UIFontFamily}">

    <StackPanel>

        <!-- Page header -->
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Configure authentication and code signing" Style="{StaticResource SubText}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ── Authentication mode toggle ── -->
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="11" Padding="4" HorizontalAlignment="Left">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.04" ShadowDepth="1" BlurRadius="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup"
                             IsChecked="{Binding IsInteractive}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{StaticResource IconUser}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Interactive" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ModeToggle}" GroupName="AuthModeGroup" Margin="3,0,0,0"
                             IsChecked="{Binding IsAppRegistration}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="App Registration" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ── Authentication Card ── -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>

                <!-- Card header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Authentication" Style="{StaticResource H2}"/>
                        <TextBlock Text="How EPS connects to Microsoft Intune &amp; Entra ID" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Interactive panel -->
                <TextBlock Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}"
                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                           Text="Sign in with your work account when prompted. No additional configuration required."/>

                <!-- App Registration panel -->
                <StackPanel Visibility="{Binding IsAppRegistration, Converter={StaticResource BoolToVis}}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tenant ID -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tenant ID" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text=" *" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" FontWeight="Bold"/>
                            </StackPanel>
                            <Grid Margin="0,7,0,0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="00000000-0000-0000-0000-000000000000"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconBuilding}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>
                        </StackPanel>

                        <!-- Application (Client) ID -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Application (Client) ID" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text=" *" Foreground="{DynamicResource PrimaryBrush}" FontSize="12.5" FontWeight="Bold"/>
                            </StackPanel>
                            <Grid Margin="0,7,0,0">
                                <TextBox Style="{StaticResource TextField}"
                                         Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="Application (Client) ID"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconApp}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Certificate source toggle -->
                    <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" Margin="0,18,0,7"/>
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource"
                                         IsChecked="{Binding AuthUseStoreCert}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Select from store" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="AuthCertSource" Margin="3,0,0,0"
                                         IsChecked="{Binding AuthUseManualThumbprint}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Enter thumbprint" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Store picker -->
                    <ComboBox Margin="0,10,0,0"
                              ItemsSource="{Binding AvailableCertificates}"
                              SelectedItem="{Binding SelectedAuthCert}"
                              Visibility="{Binding AuthUseStoreCert, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Manual thumbprint -->
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding AuthUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                        <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                 Text="{Binding AuthThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                 local:PlaceholderText.Text="40-char SHA-1 thumbprint"/>
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                            <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Grid>

                    <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run Text="Certificate must be installed in the"/>
                        <Run Text=" CurrentUser\My " FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextBrush}"/>
                        <Run Text="store on this machine."/>
                    </TextBlock>

                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Code Signing Card ── -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>

                <!-- Card header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="20" Height="20">
                            <Path Data="{StaticResource IconTag}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="{DynamicResource PrimaryBrush}" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Code Signing" Style="{StaticResource H2}"/>
                        <TextBlock Text="Authenticode certificate used to sign packaged applications" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- Enable / Disable toggle -->
                    <Border Grid.Column="2" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable"
                                         IsChecked="{Binding CodeSigningDisabled}">
                                <TextBlock Text="Disabled" VerticalAlignment="Center"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignEnable" Margin="3,0,0,0"
                                         IsChecked="{Binding CodeSigningEnabled}">
                                <TextBlock Text="Enabled" VerticalAlignment="Center"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Disabled placeholder -->
                <TextBlock Visibility="{Binding CodeSigningDisabled, Converter={StaticResource BoolToVis}}"
                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                           Text="Code signing is disabled. Packages will not be Authenticode-signed."/>

                <!-- Enabled content -->
                <StackPanel Visibility="{Binding CodeSigningEnabled, Converter={StaticResource BoolToVis}}">

                    <!-- Cert source toggle -->
                    <TextBlock Text="Certificate" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                    <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource"
                                         IsChecked="{Binding CodeSignUseStoreCert}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconBook}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Select from store" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ContextToggle}" GroupName="CodeSignCertSource" Margin="3,0,0,0"
                                         IsChecked="{Binding CodeSignUseManualThumbprint}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14">
                                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="Enter thumbprint" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Store picker -->
                    <ComboBox Margin="0,10,0,0"
                              ItemsSource="{Binding AvailableCertificates}"
                              SelectedItem="{Binding SelectedCodeSignCert}"
                              Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Thumbprint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFontFamily}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Manual thumbprint + timestamp row -->
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding CodeSignUseManualThumbprint, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Certificate Thumbprint" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                            <Grid>
                                <TextBox Style="{StaticResource TextField}" FontFamily="{StaticResource MonoFontFamily}"
                                         Text="{Binding CodeSignThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                         local:PlaceholderText.Text="SHA-1 thumbprint"/>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource Muted2Brush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                            <TextBox Style="{StaticResource TextField}"
                                     Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}"
                                     local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                        </StackPanel>
                    </Grid>

                    <!-- Timestamp server (store mode) -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding CodeSignUseStoreCert, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Timestamp Server" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>
                        <TextBox Style="{StaticResource TextField}"
                                 Text="{Binding CodeSignTimestampServer, UpdateSourceTrigger=PropertyChanged}"
                                 local:PlaceholderText.Text="http://timestamp.digicert.com"/>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Save ── -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText" Grid.Column="0" Text="{Binding SaveStatus}"
                           FontSize="12.5" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
