<UserControl x:Class="Packman.Views.ApplicationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Packman.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationDetailViewModel}"
             FontFamily="{StaticResource UIFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,26">

            <!-- Breadcrumb -->
            <Button Style="{StaticResource Breadcrumb}" Click="Back_Click" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,5,0">
                        <Path Data="{StaticResource IconChevL}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2.2" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                    <TextBlock Text="Applications" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="58" Height="58" CornerRadius="14" VerticalAlignment="Center"
                        Background="{Binding Detail.TileColor, Converter={StaticResource HexToBrush}}">
                    <TextBlock Text="{Binding Detail.Initial}" Foreground="White" FontWeight="ExtraBold" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Detail.DisplayName}" Style="{StaticResource H1}" FontSize="24" VerticalAlignment="Center"/>
                        <ContentControl Content="{Binding Detail}" ContentTemplate="{StaticResource StatusBadgeTemplate}"
                                        VerticalAlignment="Center" Margin="12,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail.SubLine}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,9,0" Click="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15"><Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                            <TextBlock Text="Update version" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,9,0" Click="Test_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15"><Path Data="{StaticResource IconLaptop}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                            <TextBlock Text="Run test" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="ViewInIntune_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="{StaticResource IconExternal}" Stroke="White" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                            <TextBlock Text="View in Intune" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource DetailTab}" GroupName="DetailTabs" Content="Overview"
                                 IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=overview}"/>
                    <RadioButton Style="{StaticResource DetailTab}" GroupName="DetailTabs" Content="Assignments"
                                 IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=assignments}"/>
                    <RadioButton Style="{StaticResource DetailTab}" GroupName="DetailTabs" Content="Detection"
                                 IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=detection}"/>
                    <RadioButton Style="{StaticResource DetailTab}" GroupName="DetailTabs" Content="Activity"
                                 IsChecked="{Binding Tab, Mode=TwoWay, Converter={StaticResource StringMatch}, ConverterParameter=activity}"/>
                </StackPanel>
            </Border>

            <!-- Body grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Main column -->
                <StackPanel Grid.Column="0">

                    <!-- OVERVIEW -->
                    <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Package Details" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ContentControl Content="{Binding Detail.Publisher}" Tag="Manufacturer" Style="{StaticResource DlRow}"/>
                                        <ContentControl Content="{Binding Detail.Version}" Tag="Version" Style="{StaticResource DlRow}"/>
                                        <ContentControl Content="{Binding Detail.InstallContext}" Tag="Install context" Style="{StaticResource DlRow}"/>
                                        <ContentControl Content="Win32 (.intunewin)" Tag="Package type" Style="{StaticResource DlRow}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <ContentControl Content="{Binding Detail.SizeFormatted}" Tag="Size" Style="{StaticResource DlRow}"/>
                                        <ContentControl Content="{Binding Detail.Id}" Tag="App ID" Style="{StaticResource DlRowMono}"/>
                                        <ContentControl Content="{Binding Detail.CreatedFormatted}" Tag="Created" Style="{StaticResource DlRow}"/>
                                        <ContentControl Content="{Binding Detail.LastModifiedFormatted}" Tag="Last updated" Style="{StaticResource DlRow}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Command Lines" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                                <TextBlock Text="Install command" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="9" Padding="13,11">
                                    <TextBlock Text="{Binding Detail.InstallCommand}" Foreground="{DynamicResource CodeTxtBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="Uninstall command" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <Border Background="{DynamicResource CodeBgBrush}" CornerRadius="9" Padding="13,11">
                                    <TextBlock Text="{Binding Detail.UninstallCommand}" Foreground="{DynamicResource CodeTxtBrush}"
                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ASSIGNMENTS -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsAssignments, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Assignments" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="Groups this app is deployed to" Style="{StaticResource SubText}" FontSize="12.5" Margin="0,0,0,16"/>
                            <ContentControl Content="{Binding RequiredAssignments}" Tag="Required" Style="{StaticResource AssignmentRow}"/>
                            <ContentControl Content="{Binding AvailableAssignments}" Tag="Available" Style="{StaticResource AssignmentRow}" Margin="0,12,0,0"/>
                            <ContentControl Content="{Binding UninstallAssignments}" Tag="Uninstall" Style="{StaticResource AssignmentRow}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DETECTION -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsDetection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Detection Rules" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Text="How Intune determines if the app is installed" Style="{StaticResource SubText}" FontSize="12.5" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding Detail.DetectionRules}"
                                          Visibility="{Binding HasDetectionRules, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="13" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No detection rules found." Foreground="{DynamicResource MutedBrush}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDetectionRules}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ACTIVITY -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsActivity, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Activity" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="21" Height="21" CornerRadius="11" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOk}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource OkBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Viewbox Width="11" Height="11" Visibility="{Binding IsOk, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Viewbox>
                                            </Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                                <TextBlock Text="{Binding When}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" Margin="2,12,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Sidebar -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Deployment status" FontSize="13.5" FontWeight="ExtraBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,14"/>

                            <StackPanel Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                                <Border Height="9" CornerRadius="5" Background="{DynamicResource Line2Brush}" Margin="0,0,0,16" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="{Binding BarInstalled}" Background="{DynamicResource OkBrush}"/>
                                        <Border Width="{Binding BarPending}" Background="{DynamicResource WarnBrush}"/>
                                        <Border Width="{Binding BarFailed}" Background="{DynamicResource BadBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ContentControl Content="{Binding SumInstalled}" Tag="Installed" Style="{StaticResource StatRow}"/>
                                <ContentControl Content="{Binding SumPending}" Tag="Pending" Style="{StaticResource StatRowWarn}"/>
                                <ContentControl Content="{Binding SumFailed}" Tag="Failed" Style="{StaticResource StatRowBad}"/>
                                <ContentControl Content="{Binding SumNotInstalled}" Tag="Not installed" Style="{StaticResource StatRowMut}"/>
                                <ContentControl Content="{Binding SumNotApplicable}" Tag="Not applicable" Style="{StaticResource StatRowMut}"/>
                            </StackPanel>

                            <TextBlock Text="No deployment data yet." Foreground="{DynamicResource MutedBrush}" FontSize="12.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSummary}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButton}" Margin="0,18,0,0" Height="42" HorizontalAlignment="Stretch"
                            Foreground="{DynamicResource DangerBrush}" Click="Retire_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0"><Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                            <TextBlock Text="Retire from Intune" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
