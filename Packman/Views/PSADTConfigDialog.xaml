<Window x:Class="Packman.Views.PSADTConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure PSADT Options"
        MinHeight="620"
        MinWidth="1020"
        Height="780"
        Width="1140"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UIFontFamily}"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Category expander style -->
        <Style x:Key="CategoryExpander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Function item row style -->
        <Style x:Key="FunctionRow" TargetType="Border">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Card2Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Phase tab button style (compact) -->
        <Style x:Key="PhaseTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Card2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small action button for preview entries -->
        <Style x:Key="PreviewActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted2Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FieldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with accent left strip -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <!-- Accent left strip -->
                <Border Width="4" HorizontalAlignment="Left" CornerRadius="0,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Primary2Color}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Header content -->
                <Grid Margin="24,18,28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Icon -->
                    <TextBlock Grid.Column="0" Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PSADT v4 Function Browser" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Name="PackageInfoText"
                                   Text="Select functions to inject into your package"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Split Panel Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Function Browser Panel -->
            <Grid Grid.Column="0" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <Border Grid.Row="0" Margin="10,10,10,6">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12,8"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Muted2Brush}"/>
                            <TextBox Name="SearchBox"
                                    Grid.Column="1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource InkBrush}"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    TextChanged="SearchBox_TextChanged"
                                    GotFocus="SearchBox_GotFocus"
                                    LostFocus="SearchBox_LostFocus"/>
                            <TextBlock Name="SearchPlaceholder"
                                      Grid.Column="1"
                                      Text="Search functions..."
                                      IsHitTestVisible="False"
                                      Foreground="{DynamicResource Muted2Brush}"
                                      FontSize="13"
                                      VerticalAlignment="Center"/>
                            <Button Name="ClearSearchButton"
                                   Grid.Column="2"
                                   Content="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Padding="4,2"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Foreground="{DynamicResource Muted2Brush}"
                                   FontSize="10"
                                   Click="ClearSearch_Click"
                                   Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Function Categories List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,2,10,8">
                    <StackPanel Name="FunctionCategoriesPanel">
                        <!-- Categories populated dynamically -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource Line2Brush}" Cursor="SizeWE"/>

            <!-- RIGHT: Live Preview Panel -->
            <Grid Grid.Column="2" Background="{DynamicResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact toolbar: phase tabs + actions in one row -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="8,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <!-- Action buttons on the right -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button Name="ClearPhaseButton" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="Clear Phase"
                                    Style="{StaticResource PreviewActionButton}"
                                    Click="ClearPhase_Click" Margin="0,0,2,0"/>
                            <Button Name="CopyPreviewButton" Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="Copy"
                                    Style="{StaticResource PreviewActionButton}"
                                    Click="CopyPreview_Click"/>
                        </StackPanel>
                        <!-- Phase tabs: single row, all 6 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Name="TabPreInstall" Content="Pre" GroupName="PhaseTab"
                                        IsChecked="True" Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                            <RadioButton Name="TabInstall" Content="Install" GroupName="PhaseTab"
                                        Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                            <RadioButton Name="TabPostInstall" Content="Post" GroupName="PhaseTab"
                                        Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                            <!-- Separator dot -->
                            <TextBlock Text="·" Foreground="{DynamicResource Line2Brush}" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <RadioButton Name="TabPreUninstall" Content="Pre" GroupName="PhaseTab"
                                        Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                            <RadioButton Name="TabUninstall" Content="Uninst" GroupName="PhaseTab"
                                        Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                            <RadioButton Name="TabPostUninstall" Content="Post" GroupName="PhaseTab"
                                        Click="PhaseTab_Click" Style="{StaticResource PhaseTabStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Code Preview (always a dark code surface so syntax colors read in both themes) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16,12"
                              Background="{DynamicResource CodeBgBrush}">
                    <StackPanel Name="PreviewEntriesPanel">
                        <TextBlock Name="EmptyPhaseText"
                                   Text="Select a function from the browser and click + Add to insert it here."
                                   Foreground="{DynamicResource CodeCommentBrush}" FontSize="12"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Padding="20,10" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Synopsis display for selected function -->
                    <Border Name="SynopsisPanel" CornerRadius="8" Padding="14,7" MaxWidth="480" Visibility="Collapsed"
                            Background="{DynamicResource PrimaryDimBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                        <TextBlock Name="SynopsisText" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource InkBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
                    </Border>

                    <!-- Double-click hint -->
                    <TextBlock Text="Double-click a function to add it"
                               FontSize="11" Foreground="{DynamicResource Muted2Brush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               FontStyle="Italic"/>

                    <!-- Counts -->
                    <Border Background="{DynamicResource Card2Brush}" CornerRadius="8" Padding="14,7"
                            Margin="14,0,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Muted2Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Functions: " FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Name="SelectedCountText" Text="0" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="CancelButton"
                            Content="Cancel"
                            Width="100"
                            Height="34"
                            Margin="0,0,10,0"
                            Style="{StaticResource GhostButton}"
                            Click="Cancel_Click"/>
                    <Button Name="ApplyButton"
                            Width="110"
                            Height="34"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Click="Apply_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Apply" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
