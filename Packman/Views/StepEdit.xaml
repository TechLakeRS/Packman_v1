<UserControl x:Class="Packman.Views.StepEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsVisibleChanged="StepEdit_IsVisibleChanged"
             FontFamily="{StaticResource UIFontFamily}">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <!-- Card header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Edit Script" Style="{StaticResource H2}"/>
                        <Border Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Review &amp; customize the generated PSADT deployment script" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CardActionButton}" VerticalAlignment="Center" Click="OpenEditor_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Open in Editor" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- No package yet -->
            <Border x:Name="EmptyState" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="11" Padding="20" Visibility="Collapsed">
                <TextBlock Text="No package generated yet. Go back to the Generate step to create the package first."
                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Editor: tree + code preview -->
            <Grid x:Name="EditorGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tree -->
                <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="8" MinHeight="360">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,8">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock x:Name="PackageNameText" Text="Package" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TreeView x:Name="FileTree" BorderThickness="0" Background="Transparent" MaxHeight="500"
                                  Foreground="{DynamicResource InkBrush}" FontSize="12.5"
                                  SelectedItemChanged="FileTree_SelectedItemChanged"/>
                    </StackPanel>
                </Border>

                <!-- Code preview -->
                <Border Grid.Column="2" Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Code top bar -->
                        <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock x:Name="CodeFileName" Text="Invoke-AppDeployToolkit.ps1" Margin="9,0,0,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource CodeBarTxtBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Code body -->
                        <TextBox Grid.Row="1" x:Name="CodeBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource CodeTxtBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                 Padding="16,14" MaxHeight="520"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
