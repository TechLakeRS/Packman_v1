<UserControl x:Class="Packman.Views.StepEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <!-- Card header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Edit Script" Style="{StaticResource H2}"/>
                        <Border Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Review &amp; customize the generated PSADT deployment script" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CardActionButton}" VerticalAlignment="Center" Click="OpenVSCode_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Open in VS Code" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Editor: tree + code preview -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tree -->
                <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="8" MinHeight="320">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,8">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Firefox v124.0.1" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                        </StackPanel>

                        <!-- Tree nodes -->
                        <StackPanel Orientation="Horizontal" Margin="14,7,10,7">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Files" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="14,7,10,7">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="SupportFiles" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <!-- Selected file -->
                        <Border Background="{DynamicResource PrimaryDimBrush}" CornerRadius="7" Padding="14,7,10,7">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <TextBlock Text="Deploy-Application.ps1" Margin="8,0,0,0" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="14,7,10,7">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="Deploy-Application.exe" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="14,7,10,7">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="AppDeployToolkit" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Code preview -->
                <Border Grid.Column="2" Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Code top bar -->
                        <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="Deploy-Application.ps1" Margin="9,0,0,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource CodeBarTxtBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Code body -->
                        <TextBlock Grid.Row="1" Margin="16,14" FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource CodeTxtBrush}" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap">
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="# Mozilla Firefox 124.0.1"/><LineBreak/>
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="## &lt;Perform Installation tasks here&gt;"/><LineBreak/>
                            <LineBreak/>
                            <Run Foreground="{DynamicResource CodeKeywordBrush}" Text="Show-InstallationWelcome"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" -CloseApps "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="'firefox'"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" -CheckDiskSpace"/><LineBreak/>
                            <LineBreak/>
                            <Run Foreground="{DynamicResource CodeKeywordBrush}" Text="Execute-MSI"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" -Action "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="'Install'"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" `"/><LineBreak/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="  -Path "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="'Firefox.msi'"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" `"/><LineBreak/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="  -Parameters "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="'/qn /norestart'"/><LineBreak/>
                            <LineBreak/>
                            <Run Foreground="{DynamicResource CodeKeywordBrush}" Text="Show-InstallationPrompt"/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text=" -Message "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="'Installation complete.'"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
