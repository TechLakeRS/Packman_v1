<UserControl x:Class="Packman.Views.StepEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             IsVisibleChanged="StepEdit_IsVisibleChanged"
             FontFamily="{StaticResource UIFontFamily}">

    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Card header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                    <Viewbox Width="18" Height="18">
                        <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Edit Script" Style="{StaticResource H2}"/>
                        <Border Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Edit the generated PSADT deployment script — completions come from the PSADT v4 catalog" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CardActionButton}" VerticalAlignment="Center" Click="OpenEditor_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconCode}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="Open in VS Code" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- No package yet -->
            <Border x:Name="EmptyState" Grid.Row="1" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="11" Padding="20" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="No package generated yet. Go back to the Generate step to create the package first."
                           FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Editor: tree + code editor, fills the remaining height -->
            <Grid x:Name="EditorGrid" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tree -->
                <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock x:Name="PackageNameText" Text="Package" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TreeView x:Name="FileTree" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                  Foreground="{DynamicResource InkBrush}" FontSize="12.5"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectedItemChanged="FileTree_SelectedItemChanged"/>
                    </Grid>
                </Border>

                <!-- Code editor (Monaco in WebView2) -->
                <Border Grid.Column="2" Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Code top bar -->
                        <Border Grid.Row="0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock x:Name="CodeFileName" Text="Invoke-AppDeployToolkit.ps1" Margin="9,0,0,0" FontFamily="{StaticResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource CodeBarTxtBrush}"/>
                                    <TextBlock x:Name="DirtyDot" Text="●" Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                                               ToolTip="Unsaved changes" Visibility="Collapsed"/>
                                    <Border Background="#2E3B67F5" BorderBrush="#733B67F5" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PSADT INTELLISENSE" FontSize="9" FontWeight="Bold" Foreground="#8FA9F9"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="EditActions" Visibility="Collapsed">
                                    <Button x:Name="RevertButton" Content="Revert" Click="Revert_Click" Cursor="Hand"
                                            Background="Transparent" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="10,3"
                                            Foreground="{DynamicResource CodeBarTxtBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                    <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Cursor="Hand"
                                            Background="{DynamicResource PrimaryBrush}" BorderThickness="0" Padding="12,3"
                                            Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Monaco editor. The bottom margin keeps the HWND clear of the
                             border's rounded corners, which it cannot be clipped to. -->
                        <Grid Grid.Row="1" MinHeight="300">
                            <wv2:WebView2 x:Name="EditorWebView" DefaultBackgroundColor="#0C1322" Margin="1,0,1,8"/>
                            <TextBlock x:Name="EditorFallbackText" Visibility="Collapsed" Margin="16,14" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5" Foreground="{DynamicResource CodeBarTxtBrush}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
