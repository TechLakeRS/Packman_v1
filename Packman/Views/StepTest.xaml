<UserControl x:Class="Packman.Views.StepTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Target Device -->
        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconLaptop}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Target Device" Style="{StaticResource H2}"/>
                            <Border Background="{DynamicResource Line2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OPTIONAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Choose a machine to deploy the test build to" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Device 1 (selected) -->
                <Border Background="{DynamicResource PrimaryDimBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="11" Padding="13" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource FieldBrush}" Margin="12,0,0,0">
                            <Viewbox Width="17" Height="17">
                                <Path Data="{StaticResource IconLaptop}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VM-WIN11-TEST" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Windows 11 23H2 · online" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="● live" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Device 2 -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,9,0,0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource Muted2Brush}" BorderThickness="2" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource FieldBrush}" Margin="12,0,0,0">
                            <Viewbox Width="17" Height="17">
                                <Path Data="{StaticResource IconLaptop}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LAB-PC-04" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Windows 10 22H2 · online" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Device 3 -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,9,0,0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource Muted2Brush}" BorderThickness="2" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource FieldBrush}" Margin="12,0,0,0">
                            <Viewbox Width="17" Height="17">
                                <Path Data="{StaticResource IconLaptop}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SANDBOX-01" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="Windows Sandbox · idle" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Test Actions -->
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimaryDimBrush}">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource PrimaryBrush}"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Test Actions" Style="{StaticResource H2}"/>
                        <TextBlock Text="What to run on the target" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Check 1 (on) -->
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="13,11" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="6" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                            <Viewbox Width="13" Height="13">
                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Run install" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Check 2 (on) -->
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,8,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="6" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                            <Viewbox Width="13" Height="13">
                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Verify detection rule" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Check 3 (off) -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,8,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="6" BorderBrush="{DynamicResource Muted2Brush}" BorderThickness="2"/>
                        <TextBlock Text="Run uninstall" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Console -->
                <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="09:41:02 "/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="queued on "/>
                            <Run Foreground="{DynamicResource CodeTxtBrush}" Text="VM-WIN11-TEST"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="09:41:04 "/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="copying .intunewin payload…"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="#4A7A5E" Text="09:41:18 "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="install exit code 0 — success"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="#4A7A5E" Text="09:41:19 "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="detection rule matched ✓"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
