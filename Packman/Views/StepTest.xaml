<UserControl x:Class="Packman.Views.StepTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource UIFontFamily}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Target Device -->
        <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
<DockPanel Margin="0,0,0,14">
    <TextBlock DockPanel.Dock="Left" Text="TEST ACTIONS" Style="{StaticResource SectionLabel}"/>
    <TextBlock DockPanel.Dock="Right" Text="What to run on the target" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Rule}"/>
</DockPanel>

                <!-- Check 1 (on) -->
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="0" Padding="13,11" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="0" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                            <Viewbox Width="13" Height="13">
                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Run install" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Check 2 (on) -->
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="0" Padding="13,11" Margin="0,8,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="0" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                            <Viewbox Width="13" Height="13">
                                <Path Data="{StaticResource IconCheck}" Stroke="White" StrokeThickness="2.6" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Verify detection rule" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Check 3 (off) -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0" Padding="13,11" Margin="0,8,0,0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="19" Height="19" CornerRadius="0" BorderBrush="{DynamicResource Muted2Brush}" BorderThickness="2"/>
                        <TextBlock Text="Run uninstall" Margin="11,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Console -->
                <Border Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0" Padding="14,12" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="09:41:02 "/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="queued on "/>
                            <Run Foreground="{DynamicResource CodeTxtBrush}" Text="VM-WIN11-TEST"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="{DynamicResource CodeCommentBrush}" Text="09:41:04 "/>
                            <Run Foreground="{DynamicResource CodeBarTxtBrush}" Text="copying .intunewin payload…"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="#4A7A5E" Text="09:41:18 "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="install exit code 0 — success"/>
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" LineHeight="22" LineStackingStrategy="BlockLineHeight">
                            <Run Foreground="#4A7A5E" Text="09:41:19 "/>
                            <Run Foreground="{DynamicResource CodeStringBrush}" Text="detection rule matched ✓"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
